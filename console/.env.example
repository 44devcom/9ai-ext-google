# Name catalog only — real values live in the sealed vault.
# Load (stdout only; do not write .env):
#   export CONFIG_PASSWORD='…'
#   vault env export --vault "$VAULT_PATH" --service gcp_console --environment local \
#     --project-credentials --password-env CONFIG_PASSWORD
# Services: platform | crawler | tunnel | dns | apify_sdk | gcp_console | aws_console
#
# GCP_CREDENTIALS_JSON is projected from vault material
# (service=gcp, name=default, format=json). Prefer: vault material / --project-credentials.
# Do not commit real keys or write gcp.json as the happy path.
GCP_CREDENTIALS_JSON=

# Optional override; if unset, project_id from JSON is used
# GCP_PROJECT=
